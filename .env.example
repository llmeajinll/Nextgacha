# 변수 목록과 용도만 적는다. 값은 Vercel / .env.local (docs/policies/deploy.md "환경변수 변경")
MONGODB_URI=            # Atlas 접속 문자열 (서버 전용)
MONGODB_DB=gacha_dev    # 운영 gacha, 로컬·Preview gacha_dev
NEXTAUTH_SECRET=
KAKAO_CLIENT_ID=        # 카카오 로그인 REST 키 (관리자 카톡 알림도 같은 앱)
KAKAO_CLIENT_SECRET=
ADMIN_EMAILS=           # 관리자 이메일, 쉼표 구분
TOSS_SECRET_KEY=        # 서버 전용. NEXT_PUBLIC_ 금지
NEXT_PUBLIC_TOSSPAYMENTS_CLIENT_KEY=
NEXT_PUBLIC_VERCEL_IMAGE_URL=
BLOB_READ_WRITE_TOKEN=  # 상품·공지 이미지 업로드 (@vercel/blob)
NEXT_PUBLIC_GTM_ID=     # 운영만
KAKAO_ADMIN_REFRESH_TOKEN=  # 관리자 카톡 알림 (talk_message 동의한 관리자 계정의 refresh token, 약 2개월마다 교체). 비우면 알림 안 보냄
PAYMENTS_DISABLED=      # 1이면 결제 차단 (장애 때, 재배포 필요)
